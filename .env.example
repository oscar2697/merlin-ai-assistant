# Ollama native API (default local endpoint)
OLLAMA_HOST=

# Models installed with `ollama pull`
MERLIN_MODEL=qwen2.5-coder:3b
MERLIN_FAST_MODEL=qwen2.5-coder:3b

# Whisper speech recognition: es (recommended), en, or auto
MERLIN_STT_LANGUAGE=auto
MERLIN_WHISPER_SIZE=small

# Optional UI behavior
MERLIN_SHOW_CURSOR=1
MERLIN_CURSOR_MODE=independent
MERLIN_WIDGET=1