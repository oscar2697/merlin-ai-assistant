# Ollama local API (Windows default)
OLLAMA_HOST=http://localhost:11434
MERLIN_MODEL=qwen2.5-coder:3b
MERLIN_FAST_MODEL=qwen2.5-coder:3b

# Voice recognition: Spanish by default. Use auto for bilingual detection or en for English.
MERLIN_STT_LANGUAGE=es
MERLIN_WHISPER_SIZE=small

# Optional: set to 1 to save temporary WAV files for debugging. Audio can contain private speech.
MERLIN_STT_DEBUG_AUDIO=0
