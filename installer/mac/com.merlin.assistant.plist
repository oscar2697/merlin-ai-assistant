<?xml version="1.0" encoding="UTF-8"?>
<!--
  MERLIN launchd agent (macOS, FUTURE target - not used in this milestone).
  Install to: ~/Library/LaunchAgents/com.merlin.assistant.plist
  Load with:  launchctl load ~/Library/LaunchAgents/com.merlin.assistant.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.merlin.assistant</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/MERLIN/Merlin.app/Contents/MacOS/Merlin</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
